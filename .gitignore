__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/
*.egg-info/
.vigilloo/
.DS_Store

# Local-only: superseded brainstorm notes, agent state, per-machine settings.
TEMP/
.superpowers/
.claude/settings.local.json

# Hypothesis writes a per-run cache of example databases and harvested constants here.
# Machine-local and regenerated on demand: committing it makes every property-test run a diff.
.hypothesis/

# Claude Code session state, including the throwaway worktrees dispatched agents run in.
# Machine-local and never part of the project.
.claude/
scratch/

# Scratch probes never go in the repo (CLAUDE.md, "Agent tooling"). These patterns catch the
# throwaway names agents reach for; a probe that needs a real name belongs in /private/tmp/.
scratch.*
tmp_scratch/
tmp_test/
debug_*.py
fix_*.py
out.txt
